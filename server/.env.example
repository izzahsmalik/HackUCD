# Server environment configuration. The server reads these from the process
# environment via plain process.env (no dotenv), so export them before starting
# (e.g. `export $(grep -v '^#' .env | xargs)` from a local .env file).

# HTTP port the Nest server listens on. Optional; defaults to 3000.
PORT=

# Set to "production" in deployed environments; blocks the /payments/dev-complete
# demo endpoint and enables stricter runtime behavior. Optional.
NODE_ENV=

# Stripe secret key (sk_test_... in dev, sk_live_... in production).
# Required for checkout sessions; missing keys fail lazily on first use.
STRIPE_SECRET_KEY=

# Stripe price ID for the premium subscription (price_...).
# Must be a recurring price; required for checkout sessions.
STRIPE_PRICE_ID=

# Stripe webhook signing secret (whsec_...) for the webhook endpoint.
# Required to accept webhook events; unsigned/unverified events are rejected.
STRIPE_WEBHOOK_SECRET=

# Absolute URL Stripe redirects to after checkout success/cancel.
# Optional; defaults to http://localhost:5173/?payment=success and
# http://localhost:5173/?payment=cancelled.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Override the Stripe API base URL (e.g. for tests or a proxy).
# Optional; defaults to https://api.stripe.com.
STRIPE_API_BASE_URL=

# OpenRouter API key for LLM-backed features. Required for the
# natural-language query endpoints; optional otherwise.
OPENROUTER_API_KEY=

# OpenRouter model identifier. Optional; defaults to microsoft/microsoft-decision-1.
OPENROUTER_MODEL=

# Directory transaction/product CSV files are ingested from.
# Optional; falls back to the built-in default ingest directory.
INGEST_DIRECTORY=

# Rows per batch when ingesting CSVs. Optional; numeric, has a built-in default.
INGEST_BATCH_SIZE=

# Maximum accepted upload size in bytes. Optional; numeric, defaults to 10 MiB.
UPLOAD_MAX_BYTES=